# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# --- Core build loop ---
GITHUB_TOKEN=                 # GitHub PAT with repo scope (github.com/settings/tokens)
VERCEL_TOKEN=                 # vercel.com/account/tokens
SUPABASE_ACCESS_TOKEN=        # supabase.com/dashboard/account/tokens (management API)
SUPABASE_PROJECT_REF=         # per-project ref, set per project or overridden at runtime
FIREBASE_TOKEN=               # `firebase login:ci` output, if a project uses Firebase instead

# --- Browser control (Playwright driving a real Chrome profile) ---
# Hermes launches Chrome with YOUR existing profile dir so it's already logged into
# YouTube/LinkedIn/WhatsApp/ChatGPT/etc. No credentials stored here for those sites.
CHROME_PROFILE_DIR=           # e.g. C:\Users\you\AppData\Local\Google\Chrome\User Data

# --- Claude Code ---
# Hermes shells out to the `claude` CLI you already have installed — no key needed here
# beyond whatever `claude` itself is already authenticated with.
